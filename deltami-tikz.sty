\def\frontcover#1{%
\setcounter{page}{-1}
\thispagestyle{empty}
\vbox to0pt{\vskip-1.02in\hbox to0pt{\hskip-2.75in\includegraphics[width=1.01\paperwidth,height=1.01\paperheight]{../#1}}}
\setcounter{page}{0}}

\def\backcover#1{%
\setcounter{page}{-1}
\thispagestyle{empty}
\vbox to0pt{\vskip-1.02in\hbox to0pt{\hskip-2.76in\includegraphics[width=1.01\paperwidth,height=1.0\paperheight]{../#1-back}}}}

\endinput